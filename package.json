{
  "name": "@rtichoke/viz",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --outfile=dist/rtichoke-viz.js && node scripts/copy-assets.mjs",
    "build:demo": "npm run schema && node scripts/build-demo.mjs",
    "schema": "esbuild scripts/generate-schema.ts --bundle --platform=node --format=esm --outfile=.tmp/generate-schema.mjs && node .tmp/generate-schema.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@observablehq/plot": "^0.6.17",
    "@sinclair/typebox": "^0.34.38"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.9",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
